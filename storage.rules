rules_version = '2';

// Règles Firebase Storage — Le Oui Parfait
// Accès authentifié requis pour toutes les opérations.
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars : tout utilisateur authentifié peut lire et uploader
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024  // max 5 Mo
        && request.resource.contentType.matches('image/.*');
    }

    // Fallback : tout utilisateur authentifié
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
