rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── Helpers auth / user ─────
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(getUserId())).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'super_admin' || getUserData().role == 'admin');
    }

    function belongsToOrg(orgId) {
      return isSignedIn() && getUserData().organizationId == orgId;
    }

    // ───── Helpers project ─────
    function getProjectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function getTaskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function isProjectMember(projectData) {
      return getUserId() == projectData.ownerId ||
             (projectData.memberIds != null && getUserId() in projectData.memberIds) ||
             (projectData.teamIds != null &&
              getUserData().teamIds != null &&
              projectData.teamIds.hasAny(getUserData().teamIds));
    }

    function isProjectEditor(projectData) {
      return getUserId() == projectData.ownerId ||
             (projectData.editorIds != null && getUserId() in projectData.editorIds) ||
             (projectData.memberIds != null && getUserId() in projectData.memberIds);
    }

    function isProjectContributor(projectData) {
      return getUserId() == projectData.ownerId ||
             (projectData.memberIds != null &&
              getUserId() in projectData.memberIds &&
              (projectData.viewerIds == null || !(getUserId() in projectData.viewerIds)));
    }

    // ───── Users ─────
    match /users/{userId} {
      // L'utilisateur peut toujours lire son propre document (rompt la récursion de getUserData)
      allow read: if isSignedIn() &&
                     (userId == getUserId() ||
                      belongsToOrg(resource.data.organizationId));

      // Mise à jour de son propre profil, sauf le rôle
      allow update: if isSignedIn() &&
                       userId == getUserId() &&
                       request.resource.data.role == resource.data.role;

      // Création / suppression / édition admin
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin();
    }

    // ───── Organizations ─────
    match /organizations/{orgId} {
      allow read: if isSignedIn() && belongsToOrg(orgId);
      allow update: if isSuperAdmin() && belongsToOrg(orgId);
      allow create, delete: if isSuperAdmin();
    }

    // ───── Teams ─────
    match /teams/{teamId} {
      allow read: if isSignedIn() && belongsToOrg(resource.data.organizationId);
      allow create, update, delete: if isSuperAdmin() &&
                                      belongsToOrg(request.resource.data.organizationId);
    }

    // ───── Projects ─────
    match /projects/{projectId} {
      // Lecture autorisée à tous les membres de l'org (filtrage côté client)
      allow read: if isSignedIn() && belongsToOrg(resource.data.organizationId);

      allow create: if isSuperAdmin() &&
                      belongsToOrg(request.resource.data.organizationId);

      allow update: if isSignedIn() &&
                       belongsToOrg(resource.data.organizationId) &&
                       (isSuperAdmin() || isProjectEditor(resource.data));

      allow delete: if isSuperAdmin() && belongsToOrg(resource.data.organizationId);
    }

    // ───── Tasks ─────
    match /tasks/{taskId} {
      allow read: if isSignedIn() &&
                     belongsToOrg(resource.data.organizationId) &&
                     (isSuperAdmin() ||
                      (resource.data.memberIds != null && getUserId() in resource.data.memberIds) ||
                      (resource.data.assigneeIds != null && getUserId() in resource.data.assigneeIds) ||
                      (resource.data.teamIds != null &&
                       getUserData().teamIds != null &&
                       resource.data.teamIds.hasAny(getUserData().teamIds)));

      allow create: if isSignedIn() &&
                       belongsToOrg(request.resource.data.organizationId) &&
                       (isSuperAdmin() ||
                        isProjectContributor(getProjectData(request.resource.data.projectId)));

      allow update: if isSignedIn() &&
                       belongsToOrg(resource.data.organizationId) &&
                       (isSuperAdmin() ||
                        isProjectEditor(getProjectData(resource.data.projectId)) ||
                        (resource.data.assigneeIds != null && getUserId() in resource.data.assigneeIds));

      allow delete: if isSignedIn() &&
                       belongsToOrg(resource.data.organizationId) &&
                       (isSuperAdmin() ||
                        isProjectEditor(getProjectData(resource.data.projectId)));
    }

    // ───── Objectives ─────
    match /objectives/{objectiveId} {
      allow read: if isSignedIn() && belongsToOrg(resource.data.organizationId);
      allow create, update, delete: if isSuperAdmin() &&
                                      belongsToOrg(request.resource.data.organizationId);
    }

    // ───── Attendance ─────
    match /attendance/{recordId} {
      allow read: if isSignedIn() &&
                     belongsToOrg(resource.data.organizationId) &&
                     (isSuperAdmin() || resource.data.userId == getUserId());

      allow create, update: if isSignedIn() &&
                               belongsToOrg(request.resource.data.organizationId) &&
                               request.resource.data.userId == getUserId();

      allow delete: if isSuperAdmin() && belongsToOrg(resource.data.organizationId);
    }

    // ───── Notifications ─────
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == getUserId();
      allow create: if isSignedIn();
    }

    // ───── Reports (legacy + split) ─────
    match /reports/{reportId} {
      allow read: if isSignedIn() && belongsToOrg(resource.data.organizationId);
      allow create: if isSignedIn() && belongsToOrg(request.resource.data.organizationId);
      allow update, delete: if isSuperAdmin() && belongsToOrg(resource.data.organizationId);
    }

    match /dailyReports/{id} {
      allow read: if isSignedIn() && belongsToOrg(resource.data.organizationId);
      allow write: if isSuperAdmin() && belongsToOrg(request.resource.data.organizationId);
    }

    match /workDayReports/{id} {
      allow read: if isSignedIn() && belongsToOrg(resource.data.organizationId);
      allow write: if isSuperAdmin() && belongsToOrg(request.resource.data.organizationId);
    }

    // ───── Comments ─────
    match /comments/{commentId} {
      allow read: if isSignedIn() &&
                     (isSuperAdmin() ||
                      isProjectMember(getProjectData(getTaskData(resource.data.taskId).projectId)));

      allow create: if isSignedIn() &&
                       isProjectMember(getProjectData(getTaskData(request.resource.data.taskId).projectId));

      allow update, delete: if isSignedIn() &&
                               (isSuperAdmin() || resource.data.authorId == getUserId());
    }

    // ───── Audit logs ─────
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ───── Password resets ─────
    match /passwordResets/{token} {
      allow read, write: if false;
    }
  }
}
